[Unit]
Description=Updating /etc from factory
DefaultDependencies=no
Conflicts=reboot.target kexec.target poweroff.target halt.target
After=systemd-fsck-root.service etc.mount
Before=local-fs.target shutdown.target

[Service]
Type=oneshot
ExecStart=/home/me/etc-factory --migrate --replace

[Install]
WantedBy=local-fs-pre.target
